# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Shape: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Supabase (Session pooler) example shape, redacted:
# DATABASE_URL="postgresql://***redacted***"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret used to sign the session cookie (HMAC-SHA256, 32+ characters).
# Generate one with: openssl rand -hex 32
# Required by src/lib/auth/session.ts — the app refuses to create sessions without it.
AUTH_SECRET="replace-with-a-random-64-character-hex-string"

# Speaking STT (server only; disabled unless explicitly enabled)
SPEAKING_STT_ENABLED=
GROQ_API_KEY=
# Required when enabled, also on a free plan: the list price used for the spend ledger
# (0.04 for whisper-large-v3-turbo at the time of writing).
SPEAKING_STT_PRICE_PER_HOUR_USD=
SPEAKING_STT_MIN_BILLED_SECONDS=
# Optional overrides may only lower the code ceilings; leave blank for the defaults
SPEAKING_STT_MAX_SECONDS=
SPEAKING_STT_MAX_BYTES=
SPEAKING_STT_DAILY_CAP=
SPEAKING_STT_REQUEST_CAP_USD=
SPEAKING_STT_PILOT_CAP_USD=
# Keep each learner's recording in the database so they can listen again and delete it.
# Only when exactly true; needs speech to text and the speaking_recordings migration.
SPEAKING_AUDIO_STORAGE_ENABLED=
# Optional: may only lower the 3 MB limit per recording (the newest 20 per learner are kept)
SPEAKING_AUDIO_MAX_BYTES=

# Conversation with AI. Off unless exactly true;
# needs SPEAKING_STT_ENABLED=true and the conversation migration.
CONVERSATION_ENABLED=
# groq (default, uses GROQ_API_KEY) or deepseek (uses AI_API_KEY and AI_BASE_URL)
CONVERSATION_PROVIDER=
# Required when enabled: a chat model id from the provider's current list. No default on purpose.
CONVERSATION_MODEL=
# Optional: an https base URL that replaces the provider default
CONVERSATION_BASE_URL=
# Optional, Groq only: reasoning_effort sent with each reply (none, default, low, medium, high;
# which values work depends on the model). "none" with qwen/qwen3.8-27b gives the fastest replies.
CONVERSATION_REASONING_EFFORT=
# Required when enabled, also on a free plan: list prices in USD per million tokens, for the ledger
CONVERSATION_PRICE_INPUT_PER_MTOK_USD=
CONVERSATION_PRICE_OUTPUT_PER_MTOK_USD=
# Optional overrides may only lower the ceilings; leave blank for the defaults
# (30 s per turn, 12 learner turns, 3 conversations per learner per day, $1 per budget period)
CONVERSATION_MAX_TURN_SECONDS=
CONVERSATION_MAX_TURNS=
CONVERSATION_DAILY_SESSIONS=
CONVERSATION_BUDGET_USD=

# Speaking AI content assessment (transcript only); off unless this AND AI_ASSESSMENT_ENABLED are exactly true
SPEAKING_AI_ASSESSMENT_ENABLED=

# Writing and Speaking AI assessment (server only). Off unless AI_ASSESSMENT_ENABLED is exactly true.
AI_ASSESSMENT_ENABLED=
# deepseek (default) or openrouter (free test mode only, also needs AI_FREE_TEST_MODE=true)
AI_PROVIDER=
AI_API_KEY=
# Optional: model id and API base URL (provider defaults are used when empty)
AI_MODEL=
AI_BASE_URL=
AI_FREE_TEST_MODE=
# Both prices are required for a paid provider (USD per million tokens)
AI_PRICE_INPUT_PER_MTOK_USD=
AI_PRICE_OUTPUT_PER_MTOK_USD=
# Spend cap in USD (default 2) and the window it applies to: month (default, UTC calendar month) or lifetime.
# The same window applies to SPEAKING_STT_PILOT_CAP_USD. Spend is recorded in the ai_usage table.
AI_PILOT_BUDGET_USD=
AI_BUDGET_PERIOD=
# Optional: request timeout in ms (default 20000, max 120000) and attempts (1 or 2, default 2)
AI_TIMEOUT_MS=
AI_MAX_ATTEMPTS=
# Optional: true prints one sanitised diagnosis line per failed assessment
AI_DIAGNOSTICS_LOG=
